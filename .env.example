# Copy this file to .env and fill in real values. Never commit .env.
# Only what a local run actually needs has to be set.

# notify / teams-notify
TEAMS_NOTIFICATION_URI=""

# whmcs-marketplace: credentials for the Marketplace account that owns the product
WHMCSMP_LOGIN=""
WHMCSMP_PASSWORD=""
# Product id, as found in the URL of the product page in the Marketplace.
WHMCSMP_PRODUCTID=""
# Lowest compatible WHMCS version (default 7.10)
# WHMCSMP_MINVERSION="7.10"

# whmcs-marketplace integration test (pnpm run test:whmcs): it publishes and then
# removes a throwaway version, so point this at a product nobody depends on.
# WHMCSMP_TEST_PRODUCTID="4887"
# WHMCSMP_TEST_VERSION="0.0.1"

# The plugin installs the browser it drives in its prepare hook. Turn that off
# where something else provisions one, and skip the OS libraries on an image
# that already carries them (installing them uses apt, so it needs sudo).
# WHMCSMP_INSTALL_BROWSER=0
# WHMCSMP_SKIP_OS_DEPS=1
# WHMCSMP_COOKIE_EXTENSION=0

# Where the browser is installed to and looked for, and an explicit browser to
# use instead of installing one.
# PUPPETEER_CACHE_DIR=".cache/puppeteer"
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/google-chrome"

# Set to 0 to watch the browser work, and PUPPETEER_KEEP_OPEN=1 to keep it open
# for a minute after a failure.
# PUPPETEER_HEADLESS=0
# PUPPETEER_KEEP_OPEN=1

# Verbose plugin logging: semantic-release:<namespace>, or semantic-release:*
# Failures are reported either way; this adds the step-by-step browser flow.
# DEBUG=semantic-release:whmcs-marketplace
